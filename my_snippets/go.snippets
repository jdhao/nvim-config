snippet main "func main" b
func main() {
	$1
}
endsnippet

snippet func "create a function" b
func $1($2) $3 {
	$4
}
endsnippet

snippet iferr "error handling" b
if err != nil {
	$1
}
endsnippet

snippet range "for range enumeration" b
for $1, $2 := range $3 {
	$4
}
endsnippet

snippet pl "fmt.Println"
fmt.Println($1)
endsnippet

snippet pf "fmt.Printf"
fmt.Printf("$1", $2)
endsnippet
